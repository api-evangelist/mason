{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mason Apps API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get App",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.getmason.io/v1/app",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "query",
                "description": "ID of the app"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Get registered app details"
        },
        {
          "info": {
            "name": "Create An App",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.getmason.io/v1/app",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "A team can create only one app (for now)"
        },
        {
          "info": {
            "name": "Delete App",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.getmason.io/v1/app/:app_id",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "path",
                "description": "app to be deleted"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "resource_owner_password_credentials",
              "accessTokenUrl": "token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Delete an app"
        }
      ]
    }
  ],
  "bundled": true
}